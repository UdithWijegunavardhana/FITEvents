{
  "name": "FITEvents",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "yarn android:dev",
    "android:dev": "react-native run-android --mode devDebug --appIdSuffix dev",
    "android:prod": "react-native run-android --mode prodDebug",
    "android:staging": "react-native run-android --mode stagingDebug --appIdSuffix staging",
    "ios": "yarn ios:dev",
    "ios:dev": "react-native run-ios --scheme FITEvents-Dev --mode Debug-Dev",
    "ios:prod": "react-native run-ios --scheme FITEvents-Prod --mode Debug-Prod",
    "ios:staging": "react-native run-ios --scheme FITEvents-Staging --mode Debug-Staging",
    "lint": "eslint .",
    "mock": "node mock-server/server.js",
    "mock:qr": "node mock-server/qr.js",
    "mock:seed": "node mock-server/seed.js",
    "postinstall": "husky",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-vector-icons/ionicons": "14.0.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@reduxjs/toolkit": "2.14.0",
    "react": "19.2.3",
    "react-hook-form": "7.91.0",
    "react-native": "0.87.1",
    "react-native-camera-kit": "18.0.1",
    "react-native-config": "1.7.2",
    "react-native-keychain": "11.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-notify-kit": "10.10.0",
    "react-native-permissions": "5.6.3",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-redux": "9.3.1",
    "redux-saga": "1.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "8.57.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "json-server": "0.17.4",
    "lint-staged": "16.4.0",
    "prettier": "2.8.8",
    "qrcode": "1.5.4",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "yarn@4.10.3",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
